# =============================================================================
# LexBase — Environment Variables
# =============================================================================
# Copy this file to .env and fill in every value marked REQUIRED.
# This file is safe to commit — it contains no real secrets.
# .env is gitignored and must NEVER be committed.
# =============================================================================

# ── PostgreSQL (Docker Compose + Backend) ────────────────────────────────────

# Database superuser name (used by Docker and SQLAlchemy)
POSTGRES_USER=lexbase

# Database password — change to a strong random string in production
# REQUIRED — do not leave as the example value
POSTGRES_PASSWORD=change_me_strong_password_here

# Database name
POSTGRES_DB=lexbase_db

# Host port Docker maps Postgres to (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433

# Full SQLAlchemy connection string — must match the values above
DATABASE_URL=postgresql://lexbase:change_me_strong_password_here@127.0.0.1:5433/lexbase_db

# ── Security ─────────────────────────────────────────────────────────────────

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — minimum 32 characters — must be kept private
SECRET_KEY=replace_with_64_hex_chars_generated_by_secrets_token_hex_32

# ── Application ──────────────────────────────────────────────────────────────

# Set to "production" on the deployed server
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example production value: https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ── Super Admin Bootstrap ────────────────────────────────────────────────────

# Credentials used by seed.py to create the initial Super Admin account
# REQUIRED — change immediately after first login
SUPER_ADMIN_EMAIL=admin@lexbase.internal
SUPER_ADMIN_PASSWORD=ChangeMe@123!

# ── LLM Provider ─────────────────────────────────────────────────────────────

# Which provider handles AI generation: groq | openrouter | ollama
LLM_PROVIDER=groq

# Groq API key — obtain from https://console.groq.com
# REQUIRED when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Groq model ID (check available models at console.groq.com/docs/models)
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter API key — obtain from https://openrouter.ai/keys
# Required only when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model ID
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ── Local LLM (Ollama) ───────────────────────────────────────────────────────

# Base URL of a locally-running Ollama server
# Required only when LLM_PROVIDER=ollama or when the frontend Local toggle is used
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model — pull first with: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# ── Document Ingestion ───────────────────────────────────────────────────────

# Directory where uploaded PDFs are stored (relative to backend/)
UPLOAD_DIR=uploads

# Maximum upload size in megabytes
MAX_FILE_SIZE_MB=25

# Maximum pages per uploaded document
MAX_PAGES_PER_DOC=800

# Maximum documents per firm
MAX_DOCS_PER_FIRM=10

# ── Frontend ─────────────────────────────────────────────────────────────────

# Base URL the React app uses for every API request
# Must match the deployed backend URL in production
VITE_API_BASE_URL=http://localhost:8000
