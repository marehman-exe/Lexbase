# Full SQLAlchemy connection string; port 5433 matches the Docker compose mapping.
DATABASE_URL=postgresql://your_db_user:your_db_password@127.0.0.1:5433/your_db_name

# Secret used to sign and verify JWT tokens — must be at least 32 random characters.
SECRET_KEY=replace_this_with_a_long_random_string_minimum_32_chars

# Controls behaviour toggles (e.g. debug logging) — set to "production" on the server.
ENVIRONMENT=development

# Comma-separated list of allowed frontend origins for CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Email address for the bootstrapped Super Admin account (created by seed.py).
SUPER_ADMIN_EMAIL=admin@lexbase.internal

# Password for the Super Admin account — change immediately after first login.
SUPER_ADMIN_PASSWORD=ChangeMeNow!

# API key for the Groq inference service — obtain from console.groq.com.
GROQ_API_KEY=your_groq_api_key_here

# Which LLM provider the backend routes chat requests to (groq | openrouter | ollama).
LLM_PROVIDER=groq

# Groq model — must use Groq's model ID (check your key's available models at console.groq.com).
# qwen/qwen3.8-27b  → confirmed live (verified against /v1/models on this key)
GROQ_MODEL=qwen/qwen3.8-27b

# API key for OpenRouter — only required when LLM_PROVIDER=openrouter or as auto-fallback.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter model — uses provider/name:tier format.
# qwen/qwen3.8-27b:free  → confirmed free and live on OpenRouter
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Ollama local inference — only needed when LLM_PROVIDER=ollama or when the frontend toggle selects Local
# Install Ollama from https://ollama.com/download then run: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b