# Production environment variables for the Vercel frontend deployment.
# Set these in the Vercel dashboard under Project → Settings → Environment Variables.
# Do NOT commit real values — this file is a template only.

# The full public URL of your deployed Railway backend (no trailing slash).
# Example: https://lexbase-backend-production.up.railway.app
VITE_API_BASE_URL=https://YOUR_RAILWAY_BACKEND_URL_HERE
